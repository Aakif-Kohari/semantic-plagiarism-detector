# ==========================================
# Application Environment Variables Template
# Copy this file to .env and replace the
# placeholder values before running locally.
# ==========================================

# Redis
REDIS_URL=redis://localhost:6379/0

# External Webhook
PLAGIARISM_WEBHOOK_URL=https://example.com/webhook

# API Authentication
API_BEARER_TOKEN=your_api_bearer_token_here

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
